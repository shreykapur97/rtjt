{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Transcribe all (data/raw_recordings)",
      "type": "debugpy",
      "request": "launch",
      "module": "pipeline.audio",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Transcribe current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pipeline.audio",
      "args": ["${file}"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
